# App
APP_ENV=development
PORT=8080
BASE_URL=https://amanly.tech
SHORT_CODE_LENGTH=7
SNOWFLAKE_NODE_ID=1

# Comma-separated browser origins allowed to call the API (CORS).
# Supports exact origins and wildcard subdomains (e.g. https://*.vercel.app).
# Defaults cover the Vite dev and preview servers and Vercel deployments.
# Set your real frontend origin(s) in production, or "*" to allow any origin
# in local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://*.vercel.app

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=24h

# Server
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
